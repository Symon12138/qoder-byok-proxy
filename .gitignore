# 本项目是独立目录（qoder-byok/），所有脚本用 $PSScriptRoot / __dirname 定位，
# 不依赖绝对路径，整个目录可以整体搬动。
# 白名单写法：先忽略根目录全部，再逐个放行需要入库的入口与目录。
/*

# ── 根目录入口（用户直接接触的只有这些）──
!/README.md
!/.gitignore
!/start.ps1
!/start.cmd
!/apply-all.ps1
!/revert-all.ps1

# ── 目录 ──
!/scripts/
!/qoder-proxy/

# ── scripts/ 里只保留脚本，运行日志不入库 ──
/scripts/_*.txt

# ── qoder-proxy 内部排除 ──
# 运行时数据（会一直增长）
/qoder-proxy/bodies/
/qoder-proxy/proxy.log
/qoder-proxy/proxy.log.*

# 含明文 apiKey，绝不入库
/qoder-proxy/config.json

# 证书：运行时代生成。私钥泄漏等于任何人都能伪造任意站点，证书本身对本机以外也无意义
/qoder-proxy/ca.crt
/qoder-proxy/ca.key
/qoder-proxy/leaf.crt
/qoder-proxy/leaf.key
/qoder-proxy/*.srl
/qoder-proxy/*.csr

# 测试脚手架产物
/qoder-proxy/_rt_out/
/qoder-proxy/_fp_out/
/qoder-proxy/_regress/

# 临时脚本（下划线开头）与备份
/qoder-proxy/_*.js
/qoder-proxy/_*.txt
/qoder-proxy/_*.png
/qoder-proxy/*.bak
/qoder-proxy/*.bak-*

# ── 本机运行物 ──
# 应用补丁时的 bundle 原始备份（只在本机保留）
/_qoder_byok_backup/
# start.ps1 拉起的服务日志
/_start_logs/

# 运行日志
/_apply_all_log.txt
/_revert_all_log.txt
