# 本项目是独立目录（qoder-byok/），所有脚本用 $PSScriptRoot / __dirname 定位，
# 不再依赖绝对路径，整个目录可以整体搬动。
# 仍用白名单写法：先忽略全部，再逐个放行需要入库的文件。
/*
!/.gitignore
!/experts-patch.js
!/apply-all.ps1
!/revert-all.ps1
!/run-experts-patch.ps1
!/fix-qoder-checksums.ps1
!/sync-qoder-model.ps1
!/mitm-test.js
!/QODER-BYOK-PATCH.md
!/qoder-proxy/

# ---- qoder-proxy 内部再排除 ----
# 运行时数据（会一直增长）
/qoder-proxy/bodies/
/qoder-proxy/proxy.log
/qoder-proxy/proxy.log.*

# 含明文 apiKey，绝不入库
/qoder-proxy/config.json

# 证书私钥：CA 私钥泄漏等于任何人都能伪造任意站点
/qoder-proxy/ca.key
/qoder-proxy/leaf.key
/qoder-proxy/*.srl
/qoder-proxy/*.csr

# 测试脚手架与产物
/qoder-proxy/_rt_out/
/qoder-proxy/_fp_out/
/qoder-proxy/_regress/

# 临时脚本（下划线开头）与备份
/qoder-proxy/_*.js
/qoder-proxy/_*.txt
/qoder-proxy/_*.png
/qoder-proxy/*.bak
/qoder-proxy/*.bak-*

# 应用补丁时的 bundle 原始备份（约 2.9 GB，只在本机保留）
/_qoder_byok_backup/

# 运行日志
/_apply_all_log.txt
/_revert_all_log.txt
/_checksum_log.txt
